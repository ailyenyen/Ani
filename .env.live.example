# A separate database prevents generated sample prices being mistaken for live data.
ANI_DATABASE_URL=sqlite:///ani_live.sqlite3
ANI_SAMPLE_DATA_NOTICE=false
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional, after verifying a public Kadiwa outlet price bulletin.
ANI_KADIWA_OUTLET_PRICE_LIST_URL=
