# Copy to .env and adjust.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (see docker-compose.yml). If unset, a local SQLite file is used.
ANI_DATABASE_URL=postgresql+psycopg2://ani:ani@localhost:5432/ani

# Show the "sample prices" notice. Set to false once real scraped data is used.
ANI_SAMPLE_DATA_NOTICE=true
ANI_SITE_URL=http://localhost:8000
ANI_SUPPORT_EMAIL=support@ani.example

# Scraper source URLs (verify each page's current structure before relying on it)
ANI_SCRAPER_DA_URL=http://www.bantaypresyo.da.gov.ph/
ANI_SCRAPER_KADIWA_URL=
ANI_SCRAPER_LOCAL_URL=

# Firebase Cloud Messaging (optional; without it alerts still appear inside Ani)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
